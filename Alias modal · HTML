<!-- Alias Manager Modal (admin-only) -->
<div id="aliasModal" class="fixed inset-0 bg-gray-900/95 z-50 flex items-center justify-center hidden p-4">
    <div class="bg-gray-800 border border-amber-700 rounded-xl p-6 sm:p-8 w-full max-w-2xl shadow-2xl max-h-[85vh] overflow-y-auto custom-scrollbar">
        <h2 class="text-2xl font-bold gold-text mb-2">Manage Item Aliases</h2>
        <p class="text-gray-400 text-sm mb-4">Map slang/shorthand names to a real item. The future chat parser will use these to resolve things like "prot ring" &rarr; "Ring of Protection".</p>

        <div class="bg-gray-900/50 p-4 rounded-lg border border-gray-700 mb-6">
            <div class="mb-3">
                <label class="block text-xs font-medium mb-1 text-gray-400">Alias / Slang</label>
                <input type="text" id="newAliasText" placeholder="e.g. prot ring" class="w-full p-2 bg-gray-700 border border-gray-600 rounded-md text-sm">
            </div>
            <div class="mb-3 relative">
                <label class="block text-xs font-medium mb-1 text-gray-400">Maps To Item</label>
                <input type="text" id="aliasItemSearch" placeholder="Search for the real item..." autocomplete="off" class="w-full p-2 bg-gray-700 border border-gray-600 rounded-md text-sm">
                <div id="aliasItemSearchResults" class="max-h-40 overflow-y-auto custom-scrollbar bg-gray-700 rounded-md mt-1 hidden absolute left-0 right-0 z-10"></div>
                <p class="text-sm font-semibold mt-2">Selected: <span id="aliasItemSelected" class="text-amber-300">none</span></p>
            </div>
            <p id="aliasAddStatus" class="text-sm mb-2"></p>
            <button id="addAliasBtn" onclick="submitNewAlias()" class="w-full py-2 bg-amber-600 hover:bg-amber-500 text-white font-bold rounded-lg transition disabled:opacity-40 disabled:cursor-not-allowed" disabled>
                Add Alias
            </button>
        </div>

        <h3 class="text-lg font-semibold text-gray-400 mb-2">Existing Aliases</h3>
        <div id="aliasListContainer" class="space-y-2 text-sm">Loading...</div>

        <button onclick="closeAliasModal()" class="w-full mt-6 py-3 bg-gray-700 hover:bg-gray-600 text-white font-bold rounded-lg transition">Close</button>
    </div>
</div>
